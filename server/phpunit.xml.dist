<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" backupGlobals="false" bootstrap="./tests/bootstrap.php" colors="true" processIsolation="false" stopOnFailure="false" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" cacheDirectory=".phpunit.cache" backupStaticProperties="false">
  <php>
    <!-- other PHP.ini or environment variables -->
    <ini name="memory_limit" value="-1"/>
    <!-- 注意：测试库隔离靠 composer test 脚本里的 DB_DATABASE=cl_test 生效。
         测试引导会先构建容器，因此 phpunit 的 env 元素在此无效。见 docs/09 第 1.1 节。 -->
    <!--
      已知偏差（2026-10-11，见 PROGRESS.md 的 Q0-9）：
      MineAdmin 自带 7 个用例（Menu/Role/UserControllerTest 的 testCreate/testSave/testUpdateInfo）
      期望「未登录请求先触发参数校验返回 422」，而 app 实际逻辑是「先鉴权返回 401」
      （后台控制器 AccessTokenMiddleware 的 priority=100 高于全局 ValidationMiddleware）。
      401 先返回才是正确行为，故不改运行时；这 7 个用例在 composer test 的 filter 参数里被排除。
    -->
  </php>
  <testsuites>
    <testsuite name="Tests">
      <directory suffix="Test.php">./tests</directory>
    </testsuite>

  </testsuites>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
      <directory suffix=".php">./databases</directory>
      <directory suffix=".php">./plugin</directory>
    </include>
    <exclude>
      <directory suffix=".php">./app/Schema</directory>
      <directory suffix=".php">./databases</directory>
    </exclude>
  </source>
</phpunit>
