# ==========================================================================
# 畅撩交友（ChangLiao）后端环境变量
#
# 用法：cp .env.example .env，再把下面标了「必填」的填上。
# 本文件**进 git**，所以：任何真实密钥都不许写在这里。
# 换一台机器部署时，下面三把密钥必须重新生成（不能沿用开发机的）。
# ==========================================================================

# ---------- 应用 ----------
APP_NAME=MineAdmin
APP_ENV=dev
APP_TIMEZONE=Asia/Shanghai
APP_DEBUG=false

# 后端自己的地址。本机上传的图片靠它拼公开 URL（storage/uploads）。
APP_URL=http://127.0.0.1:9501

# ---------- MySQL 8（必填）----------
# 本机开发：MySQL 装在 Windows 宿主（服务 MySQL80），WSL 通过 mirrored 网络连 127.0.0.1。
# 两个库：changliao（开发）、cl_test（测试，composer test 用）。
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=changliao
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
# 连接池空闲回收秒数，默认 60
# DB_MAX_IDLE_TIME=60

# ---------- Redis 7（必填）----------
# 缓存、在线状态、限流、锁都在这。测试跑 DB 15（composer test 脚本里已经带上）。
REDIS_HOST=127.0.0.1
REDIS_AUTH=
REDIS_PORT=6379
REDIS_DB=0
# REDIS_MAX_IDLE_TIME=60

# ---------- 后台（MineAdmin）登录令牌（必填）----------
# JWT_SECRET 走 base64 解码，**必须是 base64 串**。生成：
#   php -r "echo base64_encode(random_bytes(64)), PHP_EOL;"
# ⚠️ 上游自带的那个值是公开的示例密钥，一定要换掉 —— 否则任何人都能自己签一个超级管理员 token。
JWT_SECRET=
# 令牌有效期（秒），默认 1 小时；刷新令牌 2 小时；黑名单比刷新期略长
JWT_TTL=3600
JWT_REFRESH_TTL=7200
JWT_BLACKLIST_TTL=7201

# ---------- 畅撩交友 追加（见 docs/02 第 2.1 节）----------

# 实名认证里身份证号的 AES-256-GCM 密钥。**必须配**，不配的话提交实名叫接口直接报错。
# 长度随意（内部会 SHA-256 成 32 字节），但一旦有数据就别再改 —— 改了旧密文全部解不开。
# 生成：php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
CL_ID_CARD_KEY=

# App 用户 JWT 密钥。**必须与上面的 JWT_SECRET 不同**（两套令牌不能互相通用）。
CL_APP_JWT_SECRET=

# WebSocket 端口（App 连 ws://{host}:{port}/ws?token={access_token}）
CL_WS_PORT=9502

# ---------- 缓存（不填就用默认，本项目没改过）----------
# 框架缓存驱动名，默认 default（即 Redis）
# CACHE_DRIVER=default
# 数据权限（部门）缓存
# DATA_PERMISSION_CACHE_ENABLE=false
# DATA_PERMISSION_CACHE_TTL=300
# DATA_PERMISSION_CACHE_PREFIX=data_permission
# DATA_PERMISSION_CACHE_DRIVER=default

# ---------- 文件上传（本项目用本地磁盘，以下都不用填）----------
# 上传驱动在后台「运营配置 → 系统设置」里选，默认 local（存 storage/uploads）。
# COS_* / S3_* / ODBC_* 只有改用腾讯云 / 亚马逊云 / ODBC 存图片时才需要。
# COS_APPID=
# COS_SECRET_ID=
# COS_SECRET_KEY=
# S3_KEY=
# S3_SECRET=
# S3_REGION=
# S3_ENDPOINT=
# S3_BUCKET=
# ODBC_ENABLE=false
# ODBC_DSN=

# MineAdmin 应用市场令牌，只有装官方插件时才用得上，本项目留空即可。
MINE_ACCESS_TOKEN=(null)
